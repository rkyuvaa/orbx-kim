# ===== CRMFinance – KIM · Docker environment =====
# Copy to `.env` and adjust before deploying. See README.md for details.

# Postgres
POSTGRES_USER=kim
POSTGRES_PASSWORD=kimdev123
POSTGRES_DB=crmfinance

# JWT signing key — generate a long random string:
#   openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-random-64-char-string

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated allowed CORS origins (same-origin via nginx in prod)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://one.konwertindiamotors.com

# Host port for the web service
WEB_PORT=80
SSL_PORT=443

# TLS — set DOMAIN and ENABLE_SSL=true for HTTPS
DOMAIN=one.konwertindiamotors.com
ENABLE_SSL=true

# Password applied to all seeded demo accounts (sales@kim.com, finance@kim.com, delivery@kim.com, admin@kim.com)
SEED_DEFAULT_PASSWORD=Kim@2025

# 3rd Party SMS Gateway (TextGuru)
SMS_PROVIDER=textguru
SMS_API_URL=https://www.textguru.in/api/v2/SendSMS.aspx
SMS_API_METHOD=GET
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=KIMEV
SMS_ENTITY_ID=
SMS_REGISTRATION_TEMPLATE_ID=
SMS_OTP_TEMPLATE_ID=
SMS_IS_ENABLED=true
